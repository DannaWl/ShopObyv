<Window x:Class="ShopObyv.View.AddOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopObyv.View"
        mc:Ignorable="d"
        Title="Добавление заказа" Height="500" Width="600" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
           
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Right"
                    Margin="5"
                    Grid.Row="0">

            <TextBlock Text="Артикул товара"
                   Margin="7"
                   FontSize="25"/>

            <TextBlock Text="Статус заказа"
                       Margin="7"
                       FontSize="25"/>

            <TextBlock Text="ПВЗ"
                       Margin="7"
                       FontSize="25"/>

            <TextBlock Text="Дата заказа"
                       Margin="7"
                       FontSize="25"/>

            <TextBlock Text="Дата доставки"
                       Margin="7"
                       FontSize="25"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    Margin="5"
                    HorizontalAlignment="Left">
            
            <TextBox Width="230"
                     Margin="5"
                     Height="35"
                     Name="TovarArticleTextBox"/>

            <ComboBox Width="230"
                     Margin="5"
                     Height="35"
                      SelectedValue="{Binding Statys}"
                      SelectedValuePath="IdStatys"
                      DisplayMemberPath="IdStatys"
                      Name="OrderStatusComboBox"/>

            <ComboBox Width="230"
                      Margin="5"
                      Height="35"
                      SelectedValue="{Binding Pvz}"
                      SelectedValuePath="IdPvz"
                      DisplayMemberPath="Street"
                      Name="PvzComboBox"/>
            
            <!--<TextBox Width="230"
                     Margin="5"
                     Height="35"
                     Name="PvzTextBox"/>-->

            <DatePicker Width="230"
                         Margin="5"
                         Height="35"
                        Name="OrderDatePicker"/>

            <DatePicker Width="230"
                         Margin="5"
                         Height="35"
                        Name="DeliveryDatePicker"/>
            
        </StackPanel>
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="5"
                    Grid.Row="1"
                    Grid.ColumnSpan="2">

            <Button x:Name="SaveButton"
                Content="Сохранить"
                    Grid.Row="1"
                    Height="50"
                    Width="110"
                    FontSize="20"
                    Margin="5" Click="ButtonClickSaveOrder"/>

            <Button x:Name="UpdateButton"
                    Content="Обновить"
                    Height="40"
                    Width="130"
                    FontSize="18"
                    Margin="5" 
                    Click="ButtonClickUpdateOrder"/>

            <Button Content="Удалить"
                     Grid.Row="1"
                     Height="50"
                     Width="110"
                     FontSize="20"
                     Margin="5" Click="ButtonClickDeleteOrder"/>
        </StackPanel>
    </Grid>
</Window>
