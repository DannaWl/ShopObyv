<Page x:Class="ShopObyv.View.ViewTovar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopObyv.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
            Title="Список товаров">

    <Page.Resources>
        <DataTemplate x:Key="T">
            <Border BorderBrush="Black"
                    BorderThickness="1"
                    Margin="2"
                     Background="{Binding BackColor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            Margin="2">
                        
                        <Image Grid.Column="0"
                               MaxHeight="200"
                               MaxWidth="300"
                               Source="{Binding Image}" 
                               Stretch="Fill"/>
                    </Border>

                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            Grid.Column="1"
                            Margin="2">
                        <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                                <TextBlock  Margin="3" Text="{Binding Category, StringFormat={}{0}}"
                                   FontFamily="Bold"/>
                            <TextBlock Text=" | "/>
                                <TextBlock   Margin="3" Text="{Binding NameTovar, StringFormat={}{0}}"
                                   FontFamily="Bold"/>
                        </StackPanel>

                            <TextBlock  Margin="3" Text="{Binding Description, StringFormat={}Описание товара: {0}}"/>
                            <TextBlock  Margin="3" Text="{Binding Manufacture, StringFormat={}Производитель: {0}}"/>
                            <TextBlock  Margin="3" Text="{Binding Supplier, StringFormat={}Поставщик: {0}}"/>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Price, StringFormat={}Цена: {0}}"
                                       Margin="3" 
                                       TextDecorations="{Binding textDecorations}"/>

                                <TextBlock Text="{Binding NewPrice, StringFormat={}Цена: {0}}"
                                             Margin="3"
                                           Foreground="{Binding  ForgroundPrice}"/>
                            </StackPanel>

                        <TextBlock Text="{Binding Unit, StringFormat={}Единица измерения: {0}}"
                                   Margin="3"/>
                            <TextBlock  Margin="3" Text="{Binding UnitStorage,
                                StringFormat = {}Количество на складе: {0}}"
                                        Background="{Binding StorageColor}"/>
                    </StackPanel>
                    </Border>
                    
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            Grid.Column="2"
                            Margin="2">
                        <TextBlock Text="{Binding Discount, StringFormat={}Скидка: {0}%}"
                               Grid.Column="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                     </Border>
            </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ListBox Name="ListBoxTovar" 
                 ItemTemplate="{StaticResource T}" 
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ListBoxTovar_MouseDoubleClick"
                 />
    </Grid>
</Page>