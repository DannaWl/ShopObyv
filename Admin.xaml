<Window x:Class="ShopObyv.View.Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopObyv.View"
        mc:Ignorable="d"
       Title="Продажа обуви - Администратор" Height="550" Width="1100">
    <Grid x:Name="RootGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label x:Name="TitleLabel"
               Content="Панель администратора"
               HorizontalAlignment="Left"
               Grid.Row="0"
               Style="{StaticResource Label}"/>

        <Label x:Name="SubTitleLabel"
               Content="Товары"
               Grid.Row="1"
               HorizontalAlignment="Left"
               Style="{StaticResource Label}"/>

        <Label x:Name="DescLabel"
               Content="Доступны: просмотр с фильтрацией, сортировкой и поиском; добавление, редактирование и удаление товаров"
               Grid.Row="2"
               FontSize="13"
               Grid.ColumnSpan="4"
               HorizontalAlignment="Left"
               Style="{StaticResource LabelH2}" />

        <StackPanel x:Name="FilterPanel"
                    Orientation="Horizontal"
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Height="60"
                    VerticalAlignment="Top">

            <TextBox x:Name="SearchTextBox"
                     Width="250"
                     Margin="5"
                     TextChanged="Search_Changed"
                     HorizontalAlignment="Left"
                     Style="{StaticResource TextBoxA}" />

            <ComboBox x:Name="FilterComboBox"
                      Width="250"
                      Height="40"
                      Margin="5"
                      SelectionChanged="Search_Changed"
                      HorizontalAlignment="Left"/>

            <ComboBox x:Name="SortComboBox"
                      Width="250"
                      Height="40"
                      SelectionChanged="Search_Changed"
                      Margin="5"
                      HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel x:Name="TopBarPanel"
                    Orientation="Horizontal"
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    FlowDirection="RightToLeft">

            <Button Content="Выйти"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonA}" Click="Button_Click"/>

            <Label x:Name="CurrentUserLabel"
                   Content="Гареева Арина В"
                   FontSize="16"
                   HorizontalAlignment="Right"
                   Style="{StaticResource LabelH2}" />

            <Button Content="Заказы"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickZakaz"/>

            <Button Content="Товары"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickTovar"/>

            <Button Content="Аналитика"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickAnalytics"/>

            <Button x:Name="BtnPrintTovarPdf"
                    Content="Печать PDF"
                    FontSize="16"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickPrintTovarPdf"/>
        </StackPanel>

        <StackPanel x:Name="ActionButtonsPanel"
                    Grid.Row="3"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">

            <Button x:Name="BtnAddZakaz"
                    Content="Добавить заказ"
                    FontSize="16"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickAddZakaz"/>

            <Button x:Name="BtnAddTovar"
                    Content="Добавить товар"
                    FontSize="16"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickAddTovar"/>
        </StackPanel>

        <Frame x:Name="FrameAdmin"
               Source="ViewTovar.xaml"
               Grid.Row="4"
               Grid.Column="0"
               Grid.ColumnSpan="4"
               Margin="5"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>