<Page x:Class="ShopObyv.View.ViewAnalytics"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopObyv.View"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1050"
      Title="Аналитика заказов"
      FontFamily="Times New Roman">
    <Grid x:Name="AnalyticsRootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка страницы: Назад, экспорт, заголовок, пользователь и роль -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Назад"
                        Style="{StaticResource ButtonA}"
                        Click="Back_Click"
                        Padding="14,4"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0">
                <TextBlock x:Name="UserInfoTextBlock"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>
                <TextBlock x:Name="UserRoleTextBlock"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <Label Content="Аналитика заказов"
                   Style="{StaticResource H1Label}"
                   HorizontalAlignment="Left"/>
        </DockPanel>

        <!-- Выбор периода (пересчёт в реальном времени) и сводные показатели -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <Label Content="Период с:" Style="{StaticResource Label}" Margin="0,0,5,0"/>
                <DatePicker x:Name="StartDatePicker"
                            FontSize="16"
                            VerticalAlignment="Center"
                            SelectedDateChanged="Period_Changed"/>

                <Label Content="по:" Style="{StaticResource Label}" Margin="15,0,5,0"/>
                <DatePicker x:Name="EndDatePicker"
                            FontSize="16"
                            VerticalAlignment="Center"
                            SelectedDateChanged="Period_Changed"/>

                <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="20,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Производителей в топ-5" FontSize="13" Foreground="Gray"/>
                        <TextBlock x:Name="TopManufacturersText" Text="0" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Заказов за период" FontSize="13" Foreground="Gray"/>
                        <TextBlock x:Name="TotalOrdersText" Text="0" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Сумма заказов" FontSize="13" Foreground="Gray"/>
                        <TextBlock x:Name="TotalAmountText" Text="0 ₽" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Button Click="ButtonPrintToPdf_Click" Content="Экспорт в PDF" Margin="50, 0, 0, 0" Style="{StaticResource ButtonA}"/>
            </WrapPanel>
        </Border>

        <!-- Основная область: слева таблица Топ-5, справа график Топ-5 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица Топ-5 -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <Label Content="Топ-5 моделей в разрезе производителей"
                           Style="{StaticResource Label}"
                           DockPanel.Dock="Top"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,8"/>

                    <DataGrid x:Name="TopModelsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              FontSize="15"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="*"/>
                            <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*"/>
                            <DataGridTextColumn Header="Заказано пар" Binding="{Binding OrderedPairs}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- График Топ-5 -->
            <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <Label Content="График топ-5 моделей (заказано пар)"
                           Style="{StaticResource Label}"
                           DockPanel.Dock="Top"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,8"/>

                    <ItemsControl x:Name="ChartItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" FontSize="14" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ModelName}" FontWeight="Bold"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Manufacturer}"/>
                                        <Run Text=")"/>
                                    </TextBlock>

                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <Border Background="MediumOrchid"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left"
                                                Height="20"
                                                Width="{Binding BarWidth}"/>
                                        <TextBlock Text="{Binding OrderedPairs}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>