<Window x:Class="ShopObyv.View.Manager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopObyv.View"
        mc:Ignorable="d"
                           Title="Вы вошли как менеджер" Height="500" Width="1100">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>



        <Label Content="Панель менеджера"
                HorizontalAlignment="Left"
               Grid.Row="0"
               Grid.Column="1"
               Style="{StaticResource Label}"/>

        <Label Content="Товары"
                  Grid.Row="1"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                Style="{StaticResource Label}"/>

        <Label Content="Доступны: фильтрации по поставщику, сортировка по количеству на складе, поиск по всем текстовым атрибутам"
               Grid.Row="2"
               FontSize="13"
               Grid.ColumnSpan="3"
               HorizontalAlignment="Left"
             Style="{StaticResource LabelH2}" />

        <StackPanel x:Name="FilterPanel"
            Orientation="Horizontal"
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Height="60"
            VerticalAlignment="Top">

            <TextBox x:Name="SearchTextBox"
             Width="250"
             Margin="5"
             TextChanged="Search_Changed"
             HorizontalAlignment="Left"
             Style="{StaticResource TextBoxA}" />

            <ComboBox x:Name="FilterComboBox"
              Width="250"
              Height="40"
              Margin="5"
              SelectionChanged="Search_Changed"
              HorizontalAlignment="Left"/>

            <ComboBox x:Name="SortComboBox"
              Width="250"
              Height="40"
              SelectionChanged="Search_Changed"
              Margin="5"
              HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel  Orientation="Horizontal"
                     Grid.Row="0"
                     Grid.Column="3"
                     FlowDirection="RightToLeft">

            <Button Content="Выйти"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource  ButtonA}" Click="Button_Click"/>

            <Label Content="Гареева Арина В"
                   FontSize="16"
                   x:Name="CurrentUserLabel"
                   HorizontalAlignment="Right"
                   Style="{StaticResource LabelH2}" />

            <Button Content="Заказы"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickZakaz"/>

            <Button Content="Товары"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonA}"
                    Click="ButtonClickTovar"/>
        </StackPanel>

        <Frame x:Name="FrameManager"
               Source="ViewTovar.xaml"
               Grid.Row="4"
               Grid.Column="0"
               Grid.ColumnSpan="4"
               Margin="5"
               NavigationUIVisibility="Hidden"/>
        
    </Grid>
</Window>
