<Window x:Class="ShopObyv.View.Manager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopObyv.View"
        mc:Ignorable="d"
                           Title="Вы вошли как менеджер" Height="500" Width="1100">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>



        <Label Content="Панель менеджера"
                HorizontalAlignment="Left"
               Grid.Row="0"
               Grid.Column="1"
               Style="{StaticResource Label}"/>

        <Label Content="Товары"
                  Grid.Row="1"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                Style="{StaticResource Label}"/>

        <Label Content="Доступны: фильтрации по поставщику, сортировка по количеству на складе, поиск по всем текстовым атрибутам"
               Grid.Row="2"
               FontSize="13"
               Grid.ColumnSpan="3"
               HorizontalAlignment="Left"
             Style="{StaticResource LabelH2}" />

        <StackPanel Orientation="Horizontal"
                    Grid.Row="3"
                  Grid.Column="1" Height="60" Grid.RowSpan="2" VerticalAlignment="Top">

            <TextBox Width="250"
                  HorizontalAlignment="Left"
                  Style="{StaticResource TextBoxA }"  />

            <ComboBox Width=" 250"
                  Height="40"
                  HorizontalAlignment="Left">
                <ComboBoxItem Content="Все поставщики"/>
            </ComboBox>

        </StackPanel>

        <StackPanel  Orientation="Horizontal"
                     Grid.Row="0"
                     Grid.Column="3"
                     FlowDirection="RightToLeft">

            <Button Content="Выйти"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource  ButtonA}" Click="Button_Click"/>

            <Label Content="Гареева Арина В"
                   FontSize="16"
                   HorizontalAlignment="Right"
                   Style="{StaticResource LabelH2}" />

            <Button Content="Заказы"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource  ButtonA}"/>

            <Button Content="Товары"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource  ButtonA}"/>



        </StackPanel>

    </Grid>
</Window>
