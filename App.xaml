<Application x:Class="ShopObyv.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ShopObyv"
                         StartupUri="View/Autorization.xaml">
    <Application.Resources>
        <Style TargetType="Label" x:Key="TextBlockH1">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight"  Value="Bold" />
        </Style>

        <Style TargetType="Label" x:Key="H1Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight"  Value="Bold" />
        </Style>

        <Style TargetType="Label" x:Key="Label">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontWeight"  Value="Medium" />
        </Style>

        <Style TargetType="Button" x:Key="ButtonA">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight"  Value="Medium" />
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style TargetType="TextBox" x:Key="TextBoxA">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight"  Value="Medium" />
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height"  Value="40" />
            <Setter Property="Width" Value="300"/>
        </Style>

        <Style TargetType="Label" x:Key="LabelH2">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontWeight"  Value="Medium" />
        </Style>


        <Style TargetType="PasswordBox" x:Key="Pass">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height"  Value="40" />
            <Setter Property="Width" Value="300"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontWeight"  Value="Medium" />
        </Style>
        
        <Style TargetType="TextBlock" x:Key="TextBlockA">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight"  Value="Bold" />
        </Style>
    </Application.Resources>
</Application>