<Window x:Class="ShopObyv.View.Client"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopObyv.View"
        mc:Ignorable="d"
                      Title="Вы вошли как клиент" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>



        <Label Content="Просмотр товаров"
                HorizontalAlignment="Left"
               Grid.Row="0"
               Grid.Column="1"
               Style="{StaticResource Label}"/>

        <Label Content="Список товаров"
                  Grid.Row="1"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                Style="{StaticResource Label}"/>

        <Label Content="Доступен просмотр товаров без фильтраци, сортировки и поиска"
               Grid.Row="2"
               Grid.Column="1"
               HorizontalAlignment="Left"
             Style="{StaticResource LabelH2}" />

        <Label Content="Гареева Арина В"
              Grid.Row="0"
              FontSize="16"
              Grid.Column="2"
              HorizontalAlignment="Right"
               Style="{StaticResource LabelH2}" />

        <Button Content="Выйти"
                  Grid.Row="0"
                FontSize="16"
                  Grid.Column="3"
                  HorizontalAlignment="Right"
                Style="{StaticResource  ButtonA}"/>



    </Grid>
</Window>

