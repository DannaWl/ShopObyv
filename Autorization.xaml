<Window x:Class="ShopObyv.View.Autorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopObyv.View"
        mc:Ignorable="d"
             Title="Вход в исстему" Height="450" Width="800">

    <Window.Resources>


    </Window.Resources>

    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>


        <Label Content="Добро пожаловать в Магазин!"
               Grid.ColumnSpan="2"
               Style="{StaticResource H1Label}"
               />

        <Label Content="Логин (электронная почта)"
               Grid.Row="1"
               
                Style="{StaticResource Label}"
               />

        <TextBox x:Name="login"
                  Grid.Row="2"
                  Style="{StaticResource TextBoxA}"/>

        <Label Content="Пароль"
               Grid.Row="3"
               Style="{StaticResource Label}"/>


        <PasswordBox x:Name="pass1"
            Grid.Row="4"
                 Style="{StaticResource  Pass}"/>

        <Border Grid.Row="5"
                CornerRadius="25"
                Height="50"
                Width="200"
                Background="MediumOrchid">

            <Button Content="Войти"
                    Background="Transparent"
                    Foreground="White" 
                    Style="{StaticResource  ButtonA}"
                    Click="Vhod"/>
        </Border>

        <Border Grid.Row="6"
          CornerRadius="25"
          Height="50"
          Width="300"
          Background="MediumOrchid">

            <Button Content="Войти как Гость"
         Background="Transparent"
         Foreground="White" 
         Style="{StaticResource  ButtonA}"
                          Click="VhodGhost"/>
        </Border>

    </Grid>
</Window>
