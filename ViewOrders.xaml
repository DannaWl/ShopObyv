<Page x:Class="ShopObyv.View.ViewOrders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopObyv.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Просмотр заказов">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.07*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ListBox SelectedItem="{Binding Selected}"
                     Name="OrderTovars"
                     Background="White" 
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Grid.Row="1" MouseDoubleClick="ViewOrdersDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black"
                                BorderThickness="1" 
                                Padding="8"
                                Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                
                            <Border BorderBrush="Black"
                                     BorderThickness="1" 
                                     Padding="8"
                                    Margin="5"
                                     Background="White">
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,15,0">

                                    <TextBlock FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5">
                                    <Run Text="Артикул: "/>
                                    <Run Text="{Binding ArticleZakaa}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding IdSostavaZakazaNavigation.Statys, StringFormat='Статус: {0}'}"
                                           Margin="0,0,0,5"/>
                                <TextBlock>
                                    <Run Text="ПВЗ: "/>
                                    <Run Text="{Binding IdSostavaZakazaNavigation.PvzNavigation.Gorod}"/>, 
                                    <Run Text="{Binding IdSostavaZakazaNavigation.PvzNavigation.Street}"/>, 
                                    <Run Text="{Binding IdSostavaZakazaNavigation.PvzNavigation.Dom}"/>
                                </TextBlock>
                                    <TextBlock Text="{Binding IdSostavaZakazaNavigation.DateOrder, StringFormat={}Дата заказа: {0:dd.MM.yyyy}}" />
                            
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="Black" 
                                    BorderThickness="3"
                                    Padding="8"
                                     Margin="5"
                                    Grid.Column="1">
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                <TextBlock Text="Дата доставки" 
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding IdSostavaZakazaNavigation.DarteDilivery, StringFormat=dd.MM.yyyy}" 
                                           FontSize="16"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            </Border>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
    </Grid>
</Page>
